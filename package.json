{
  "name": "tact-lifestyle-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "theme:check": "pnpm dlx @shopify/cli@latest theme check --path shopify-theme",
    "theme:dev": "pnpm dlx @shopify/cli@latest theme dev --path shopify-theme --environment development --theme-editor-sync",
    "theme:package": "powershell -ExecutionPolicy Bypass -File scripts/build-shopify-theme.ps1 -SourceDirectory shopify-theme -DestinationFile tact-editorial-catalog-ready-1.4.3.zip",
    "theme:push:draft": "pnpm dlx @shopify/cli@latest theme push --path shopify-theme --environment development --unpublished"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
