<section class="t-section">
  <div class="t-section-title">
    <div>
      <p class="t-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div>
      <p>{{ section.settings.copy }}</p>
      {% if section.settings.collection != blank %}
        <a class="t-text-link" href="{{ section.settings.collection.url }}">
          {{ section.settings.link_label }} {% render 'icon', icon: 'arrow' %}
        </a>
      {% endif %}
    </div>
  </div>
  <div class="t-product-grid">
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', card_product: product %}
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <article class="t-product-card">
          <div class="t-product-card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
          <div class="t-product-card__info"><h3>Choose a featured collection</h3></div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 / Just landed"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Just landed."},
    {"type": "textarea", "id": "copy", "label": "Copy", "default": "New graphics, oversized tees and everyday layers from TACT."},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "text", "id": "link_label", "label": "Link label", "default": "Shop all pieces"},
    {"type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4}
  ],
  "presets": [{"name": "Product grid"}]
}
{% endschema %}
