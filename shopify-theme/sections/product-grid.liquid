{% liquid
  assign showcase_collection = section.settings.collection
  if showcase_collection == blank
    assign showcase_collection = collections['all']
  endif
  assign showcase_link = section.settings.link
  if showcase_link == blank and showcase_collection != blank
    assign showcase_link = showcase_collection.url
  endif
  assign showcase_has_products = false
  if showcase_collection != blank and showcase_collection.products_count > section.settings.product_offset
    assign showcase_has_products = true
  endif
%}
<section
  class="t-section t-product-showcase{% if section.settings.mobile_scroll %} t-product-showcase--mobile-scroll{% endif %}"
  style="
    --products-columns: {{ section.settings.columns }};
    --products-columns-mobile: {{ section.settings.columns_mobile }};
    --products-ratio: {{ section.settings.image_ratio }};
    --products-radius: {{ section.settings.card_radius }}px;
    --products-heading-size: {{ section.settings.heading_size }}px;
    --products-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --products-title-size: {{ section.settings.product_title_size }}px;
    --products-image-fit: {{ section.settings.image_fit }};
    --products-background: {{ section.settings.background }};
    --products-text: {{ section.settings.text_color }};
    --products-padding-top: {{ section.settings.padding_top }}px;
    --products-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% if section.settings.show_heading %}
    <div class="t-section-title">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="t-kicker">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div>
        {% if section.settings.copy != blank %}<p>{{ section.settings.copy }}</p>{% endif %}
        {% if section.settings.link_label != blank %}
          <a class="t-text-link" href="{{ showcase_link | default: routes.all_products_collection_url }}">
            {{ section.settings.link_label }} {% render 'icon', icon: 'arrow' %}
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}
  {% if showcase_has_products %}
    <div class="t-product-grid">
      {% for product in showcase_collection.products limit: section.settings.products_to_show offset: section.settings.product_offset %}
        {% render 'product-card', card_product: product, quick_add: section.settings.show_quick_add, wishlist: section.settings.show_wishlist %}
      {% endfor %}
    </div>
  {% else %}
    <div class="t-product-showcase__empty">
      <p class="t-kicker">{% if request.design_mode %}Shopify setup{% else %}{{ section.settings.empty_eyebrow }}{% endif %}</p>
      <h3>{% if request.design_mode %}Choose a collection or import the TACT catalog.{% else %}{{ section.settings.empty_heading }}{% endif %}</h3>
      <p>{% if request.design_mode %}This section automatically uses the store's All collection when no collection is selected.{% else %}{{ section.settings.empty_copy }}{% endif %}</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    {"type": "header", "content": "Content"},
    {"type": "checkbox", "id": "show_heading", "label": "Show section heading", "default": true},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 / Just landed"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Just landed."},
    {"type": "textarea", "id": "copy", "label": "Copy", "default": "New graphics, oversized tees and everyday layers from TACT."},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "url", "id": "link", "label": "Custom section link"},
    {"type": "text", "id": "link_label", "label": "Link label", "default": "Shop all pieces"},
    {"type": "header", "content": "Products"},
    {"type": "range", "id": "products_to_show", "min": 2, "max": 16, "step": 1, "label": "Products to show", "default": 4},
    {"type": "range", "id": "product_offset", "min": 0, "max": 24, "step": 1, "label": "Skip first products", "default": 0, "info": "Use this when a second product section should continue from the same collection."},
    {"type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Desktop columns", "default": 4},
    {"type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Mobile columns", "default": 2},
    {"type": "checkbox", "id": "mobile_scroll", "label": "Use horizontal product rail on mobile", "default": false},
    {"type": "checkbox", "id": "show_quick_add", "label": "Show quick add and size selection", "default": true},
    {"type": "checkbox", "id": "show_wishlist", "label": "Show wishlist buttons", "default": true},
    {"type": "select", "id": "image_ratio", "label": "Product image ratio", "default": "4 / 5", "options": [
      {"value": "1 / 1", "label": "Square"},
      {"value": "4 / 5", "label": "Portrait"},
      {"value": "3 / 4", "label": "Tall portrait"},
      {"value": "auto", "label": "Natural"}
    ]},
    {"type": "select", "id": "image_fit", "label": "Product image fit", "default": "cover", "options": [
      {"value": "cover", "label": "Fill the card"},
      {"value": "contain", "label": "Show the full product"}
    ]},
    {"type": "range", "id": "card_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14},
    {"type": "range", "id": "product_title_size", "label": "Product title size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 13},
    {"type": "header", "content": "Empty collection"},
    {"type": "text", "id": "empty_eyebrow", "label": "Eyebrow", "default": "TACT / Incoming"},
    {"type": "text", "id": "empty_heading", "label": "Heading", "default": "The next drop is being prepared."},
    {"type": "textarea", "id": "empty_copy", "label": "Copy", "default": "Products will appear here as soon as they are published."},
    {"type": "header", "content": "Section sizing"},
    {"type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 40, "max": 110, "step": 2, "unit": "px", "default": 78},
    {"type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 36, "max": 72, "step": 2, "unit": "px", "default": 54},
    {"type": "range", "id": "padding_top", "label": "Top spacing", "min": 30, "max": 180, "step": 5, "unit": "px", "default": 100},
    {"type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 30, "max": 180, "step": 5, "unit": "px", "default": 100},
    {"type": "color", "id": "background", "label": "Background", "default": "#f3f3f1"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#0b0b0c"}
  ],
  "presets": [{"name": "Product showcase"}]
}
{% endschema %}
