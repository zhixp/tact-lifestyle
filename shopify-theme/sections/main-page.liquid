<article class="t-page">
  <header>
    <p class="t-kicker">{{ section.settings.eyebrow }}</p>
    <h1>{{ page.title }}</h1>
  </header>
  <div class="rte t-page__content">{{ page.content }}</div>
</article>

{% schema %}
{
  "name": "Main page",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TACT Lifestyle"}
  ]
}
{% endschema %}
