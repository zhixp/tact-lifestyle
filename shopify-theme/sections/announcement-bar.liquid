{% if section.settings.show_bar %}
  <style>:root { --t-announcement-height: {{ section.settings.height }}px; }</style>
  <aside
    class="t-announcement{% if section.settings.pause_on_hover %} t-announcement--pause{% endif %} t-announcement--{{ section.settings.direction }}"
    style="
      --announcement-bg: {{ section.settings.background }};
      --announcement-color: {{ section.settings.text_color }};
      --announcement-speed: {{ section.settings.speed }}s;
      --announcement-size: {{ section.settings.font_size }}px;
      --announcement-gap: {{ section.settings.gap }}px;
    "
    aria-label="{{ section.settings.aria_label | escape }}"
  >
    <div class="t-announcement__track">
      {% for duplicate in (1..2) %}
        <div class="t-announcement__group"{% if duplicate == 2 %} aria-hidden="true"{% endif %}>
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% else %}<span {{ block.shopify_attributes }}>{% endif %}
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
                {% endif %}
                {{ block.settings.text }}
              {% if block.settings.link != blank %}</a>{% else %}</span>{% endif %}
              {% if section.settings.show_separator %}<i aria-hidden="true">{{ section.settings.separator }}</i>{% endif %}
            {% endfor %}
          {% else %}
            <span>Free delivery over ₹499</span><i aria-hidden="true">•</i>
            <span>Extra 5% off prepaid orders</span><i aria-hidden="true">•</i>
            <span>New drops from TACT</span><i aria-hidden="true">•</i>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </aside>
{% else %}
  <style>:root { --t-announcement-height: 0px; }</style>
{% endif %}

{% schema %}
{
  "name": "Announcement ticker",
  "max_blocks": 12,
  "settings": [
    {"type": "checkbox", "id": "show_bar", "label": "Show announcement ticker", "default": true},
    {"type": "range", "id": "height", "label": "Bar height", "min": 24, "max": 52, "step": 1, "unit": "px", "default": 30},
    {"type": "range", "id": "font_size", "label": "Text size", "min": 8, "max": 16, "step": 1, "unit": "px", "default": 10},
    {"type": "range", "id": "gap", "label": "Message spacing", "min": 16, "max": 100, "step": 4, "unit": "px", "default": 48},
    {"type": "range", "id": "speed", "label": "Ticker duration", "min": 12, "max": 60, "step": 1, "unit": "s", "default": 26},
    {"type": "select", "id": "direction", "label": "Direction", "default": "left", "options": [
      {"value": "left", "label": "Left"},
      {"value": "right", "label": "Right"}
    ]},
    {"type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true},
    {"type": "checkbox", "id": "show_separator", "label": "Show separator", "default": true},
    {"type": "text", "id": "separator", "label": "Separator", "default": "•"},
    {"type": "color", "id": "background", "label": "Background", "default": "#0a0a0a"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#ffffff"},
    {"type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Store announcements"}
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {"type": "image_picker", "id": "icon", "label": "Optional icon"},
        {"type": "text", "id": "text", "label": "Text", "default": "Free delivery over ₹499"},
        {"type": "url", "id": "link", "label": "Optional link"}
      ]
    }
  ]
}
{% endschema %}
