<section class="t-list-collections">
  <header>
    <p class="t-kicker">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
  </header>
  <div class="t-list-collections__grid">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        <a href="{{ collection.url }}">
          {% if collection.featured_image %}
            {{
              collection.featured_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 700, 900, 1200',
                sizes: '(max-width: 749px) 82vw, 50vw',
                alt: collection.title
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag }}
          {% endif %}
          <span>
            <strong>{{ collection.title }}</strong>
            <small>{{ collection.products_count }} pieces</small>
          </span>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TACT / Collections"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Shop by mood."}
  ]
}
{% endschema %}
