<section class="t-password">
  <div class="t-password__panel">
    <p class="t-kicker">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.copy }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <label for="StorefrontPassword">{{ section.settings.password_label }}</label>
      <div>
        <input
          id="StorefrontPassword"
          type="password"
          name="password"
          autocomplete="current-password"
          required
        >
        <button class="t-button" type="submit">
          {{ section.settings.button_label }} {% render 'icon', icon: 'arrow' %}
        </button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TACT / Private access"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "The next drop is almost here."},
    {"type": "textarea", "id": "copy", "label": "Copy", "default": "Enter the store password to preview the latest TACT experience."},
    {"type": "text", "id": "password_label", "label": "Password label", "default": "Store password"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Enter store"}
  ]
}
{% endschema %}
