<section
  class="t-editorial t-editorial--{{ section.settings.layout }}"
  style="
    --editorial-background: {{ section.settings.background }};
    --editorial-text: {{ section.settings.text_color }};
    --editorial-media-background: {{ section.settings.media_background }};
    --editorial-height: {{ section.settings.desktop_height }}px;
    --editorial-heading-size: {{ section.settings.heading_size }}px;
    --editorial-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --editorial-image-fit: {{ section.settings.image_fit }};
    --editorial-image-position: {{ section.settings.image_position }};
  "
>
  <div class="t-editorial__media">
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'lazy',
          widths: '500, 750, 1100, 1500, 1800',
          sizes: '(max-width: 749px) 100vw, 65vw',
          alt: section.settings.image.alt
      }}
    {% else %}
      <img src="{{ 'editorial-demo.webp' | asset_url }}" width="1648" height="2528" loading="lazy" alt="{{ section.settings.heading | escape }}">
    {% endif %}
  </div>
  <div class="t-editorial__copy">
    <p class="t-kicker">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div>{{ section.settings.copy }}</div>
    {% if section.settings.button_label != blank %}
      <a class="t-button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }} {% render 'icon', icon: 'arrow' %}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Editorial image and text",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "select", "id": "layout", "label": "Image position", "default": "image-left", "options": [
      {"value": "image-left", "label": "Left"},
      {"value": "image-right", "label": "Right"}
    ]},
    {"type": "select", "id": "image_fit", "label": "Image fit", "default": "contain", "options": [
      {"value": "contain", "label": "Show the full image"},
      {"value": "cover", "label": "Fill and crop"}
    ]},
    {"type": "select", "id": "image_position", "label": "Image focal point", "default": "center", "options": [
      {"value": "left center", "label": "Left"},
      {"value": "center", "label": "Center"},
      {"value": "right center", "label": "Right"}
    ]},
    {"type": "range", "id": "desktop_height", "label": "Desktop section height", "min": 500, "max": 780, "step": 20, "unit": "px", "default": 620},
    {"type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 42, "max": 96, "step": 2, "unit": "px", "default": 72},
    {"type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 32, "max": 60, "step": 2, "unit": "px", "default": 46},
    {"type": "color", "id": "background", "label": "Section background", "default": "#ebece8"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#0b0b0c"},
    {"type": "color", "id": "media_background", "label": "Image background", "default": "#0b0b0c"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "02 / Sleeveless society"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Hard lines. Easy movement."},
    {"type": "richtext", "id": "copy", "label": "Copy", "default": "<p>A relaxed statement shaped by sharp graphics and tactile detail.</p>"},
    {"type": "url", "id": "link", "label": "Link"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Discover the piece"}
  ],
  "presets": [{"name": "Editorial image and text"}]
}
{% endschema %}
