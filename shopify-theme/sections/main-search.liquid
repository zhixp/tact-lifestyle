<section class="t-search-page">
  <header>
    <p class="t-kicker">TACT / Search</p>
    <h1>Find your flex.</h1>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products">
      <button type="submit">{% render 'icon', icon: 'arrow' %}</button>
    </form>
  </header>
  {% if search.performed %}
    <div class="t-collection-grid">
      {% for item in search.results %}
        {% if item.object_type == 'product' %}
          {% render 'product-card', card_product: item %}
        {% endif %}
      {% else %}
        <p>No products matched “{{ search.terms }}”.</p>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{"name": "Main search", "settings": []}
{% endschema %}
