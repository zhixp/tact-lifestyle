<section
  class="t-collection-tiles"
  style="
    --category-columns: {{ section.settings.columns }};
    --category-mobile-width: {{ section.settings.mobile_card_width }}vw;
    --category-ratio: {{ section.settings.image_ratio }};
    --category-radius: {{ section.settings.card_radius }}px;
    --category-heading-size: {{ section.settings.heading_size }}px;
    --category-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --category-background: {{ section.settings.background }};
    --category-text: {{ section.settings.text_color }};
    --category-padding-top: {{ section.settings.padding_top }}px;
    --category-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% if section.settings.show_heading %}
    <div class="t-section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="t-kicker">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div>
        {% if section.settings.copy != blank %}<p>{{ section.settings.copy }}</p>{% endif %}
        {% if section.settings.link_label != blank %}
          <a class="t-text-link" href="{{ section.settings.link | default: routes.collections_url }}">
            {{ section.settings.link_label }} {% render 'icon', icon: 'arrow' %}
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}
  <div class="t-collection-tiles__grid">
    {% for block in section.blocks %}
      {% liquid
        assign chosen_collection = block.settings.collection
        if chosen_collection == blank and block.settings.fallback_handle != blank
          assign chosen_collection = collections[block.settings.fallback_handle]
        endif
        assign card_link = block.settings.link
        if card_link == blank and chosen_collection != blank
          assign card_link = chosen_collection.url
        endif
        assign card_image = block.settings.image
        if card_image == blank and chosen_collection != blank
          assign card_image = chosen_collection.featured_image
        endif
        assign all_collection = collections['all']
        assign fallback_product = all_collection.products | slice: forloop.index0, 1 | first
        if card_image == blank and chosen_collection != blank
          assign card_image = chosen_collection.products.first.featured_image
        endif
        if card_image == blank and fallback_product != blank
          assign card_image = fallback_product.featured_image
        endif
        assign card_title = block.settings.title
        if card_title == blank and chosen_collection != blank
          assign card_title = chosen_collection.title
        endif
        assign overlay_alpha = block.settings.overlay_opacity | divided_by: 100.0
        assign overlay_color = block.settings.overlay_color | color_modify: 'alpha', overlay_alpha
      %}
      <a
        href="{{ card_link | default: routes.all_products_collection_url }}"
        class="t-collection-tile"
        style="--category-overlay: {{ overlay_color }}; --category-focal: {{ block.settings.image_position }};"
        {{ block.shopify_attributes }}
      >
        {% if card_image %}
          {{
            card_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '320, 480, 640, 900, 1200',
              sizes: '(max-width: 749px) 72vw, 25vw',
              alt: card_title
          }}
        {% else %}
          {% case forloop.index %}
            {% when 1 %}
              <img src="{{ 'hero-editorial-v2.webp' | asset_url }}" width="1568" height="1003" loading="lazy" alt="{{ card_title | escape }}">
            {% when 2 %}
              <img src="{{ 'hero-demo.webp' | asset_url }}" width="1872" height="1200" loading="lazy" alt="{{ card_title | escape }}">
            {% when 3 %}
              <img src="{{ 'editorial-demo.webp' | asset_url }}" width="1648" height="2528" loading="lazy" alt="{{ card_title | escape }}">
            {% else %}
              <img src="{{ 'hero-madison.png' | asset_url }}" width="1648" height="2528" loading="lazy" alt="{{ card_title | escape }}">
          {% endcase %}
        {% endif %}
        {% if section.settings.show_numbers %}<span class="t-collection-tile__number">{{ forloop.index | prepend: '0' }}</span>{% endif %}
        <strong>{{ card_title | default: 'Collection' }}</strong>
        {% render 'icon', icon: 'arrow' %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection categories",
  "max_blocks": 12,
  "settings": [
    {"type": "header", "content": "Content"},
    {"type": "checkbox", "id": "show_heading", "label": "Show section heading", "default": true},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 / Find your everyday drip"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Explore streetwear by category."},
    {"type": "textarea", "id": "copy", "label": "Copy", "default": "Men, women and unisex pieces from the current TACT catalog."},
    {"type": "text", "id": "link_label", "label": "Link label", "default": "Shop all products"},
    {"type": "url", "id": "link", "label": "Section link"},
    {"type": "checkbox", "id": "show_numbers", "label": "Show category numbers", "default": true},
    {"type": "header", "content": "Grid and sizing"},
    {"type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4},
    {"type": "range", "id": "mobile_card_width", "label": "Mobile card width", "min": 55, "max": 92, "step": 1, "unit": "%", "default": 72},
    {"type": "select", "id": "image_ratio", "label": "Card ratio", "default": "1 / 1", "options": [
      {"value": "1 / 1", "label": "Square"},
      {"value": "4 / 5", "label": "Portrait"},
      {"value": "3 / 4", "label": "Tall portrait"},
      {"value": "16 / 10", "label": "Landscape"}
    ]},
    {"type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18},
    {"type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 40, "max": 110, "step": 2, "unit": "px", "default": 78},
    {"type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 36, "max": 72, "step": 2, "unit": "px", "default": 54},
    {"type": "range", "id": "padding_top", "label": "Top spacing", "min": 30, "max": 180, "step": 5, "unit": "px", "default": 90},
    {"type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 30, "max": 180, "step": 5, "unit": "px", "default": 90},
    {"type": "color", "id": "background", "label": "Background", "default": "#f3f3f1"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#0b0b0c"}
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category",
      "settings": [
        {"type": "collection", "id": "collection", "label": "Collection"},
        {"type": "image_picker", "id": "image", "label": "Custom image"},
        {"type": "text", "id": "title", "label": "Custom title"},
        {"type": "url", "id": "link", "label": "Custom link"},
        {"type": "text", "id": "fallback_handle", "label": "Demo collection handle"},
        {"type": "select", "id": "image_position", "label": "Image focal point", "default": "center center", "options": [
          {"value": "left center", "label": "Left"},
          {"value": "center center", "label": "Center"},
          {"value": "right center", "label": "Right"},
          {"value": "center top", "label": "Top"},
          {"value": "center bottom", "label": "Bottom"}
        ]},
        {"type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000"},
        {"type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55}
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection categories",
      "blocks": [
        {"type": "collection", "settings": {"fallback_handle": "new-arrivals", "title": "New arrivals"}},
        {"type": "collection", "settings": {"fallback_handle": "men", "title": "Men"}},
        {"type": "collection", "settings": {"fallback_handle": "shop-womens", "title": "Women"}},
        {"type": "collection", "settings": {"fallback_handle": "unisex", "title": "Unisex"}},
        {"type": "collection", "settings": {"fallback_handle": "co-ord-set-women", "title": "Co-ord sets"}},
        {"type": "collection", "settings": {"fallback_handle": "tact-joggers-men", "title": "Joggers"}},
        {"type": "collection", "settings": {"fallback_handle": "hoodies-men", "title": "Hoodies"}},
        {"type": "collection", "settings": {"fallback_handle": "neon-rush-all-products", "title": "Neon Rush"}}
      ]
    }
  ]
}
{% endschema %}
