<!doctype html>
<html
  lang="{{ request.locale.iso_code }}"
  data-theme="{% if settings.default_color_mode == 'dark' %}dark{% else %}light{% endif %}"
  data-theme-default="{{ settings.default_color_mode }}"
  data-theme-enabled="{{ settings.enable_dark_mode }}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {% endif %}
    <title>
      {{ page_title }}
      {%- if current_tags %} — {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} — Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {% if settings.enable_dark_mode %}
      <script>
        (() => {
          try {
            const saved = localStorage.getItem('tact-theme');
            const fallback = document.documentElement.dataset.themeDefault;
            const theme = saved || (fallback === 'system'
              ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
              : fallback);
            document.documentElement.dataset.theme = theme;
          } catch (_) {}
        })();
      </script>
    {% endif %}

    {{ content_for_header }}

    {% liquid
      assign body_font_bold = settings.body_font | font_modify: 'weight', '700'
      assign heading_font_bold = settings.heading_font | font_modify: 'weight', '700'
    %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'refinement.css' | asset_url | stylesheet_tag }}
    {{ 'editorial-system.css' | asset_url | stylesheet_tag }}
    <style>
      {{ settings.body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ settings.heading_font | font_face: font_display: 'swap' }}
      {{ heading_font_bold | font_face: font_display: 'swap' }}
      {{ settings.accent_font | font_face: font_display: 'swap' }}

      :root {
        --tact-ink: {{ settings.color_ink }};
        --tact-paper: {{ settings.color_paper }};
        --tact-surface: {{ settings.color_surface }};
        --tact-muted: {{ settings.color_muted }};
        --tact-accent: {{ settings.color_accent }};
        --tact-button: {{ settings.color_button }};
        --tact-button-text: {{ settings.color_button_text }};
        --tact-line: color-mix(in srgb, var(--tact-ink) 15%, transparent);
        --tact-soft: color-mix(in srgb, var(--tact-surface) 82%, var(--tact-paper));
        --tact-on-strong: var(--tact-paper);
        --tact-shadow: rgb(0 0 0 / 14%);
        --tact-radius: {{ settings.card_radius }}px;
        --tact-button-radius: {{ settings.button_radius }}px;
        --tact-button-height: {{ settings.button_height }}px;
        --tact-page: max({{ settings.page_padding }}px, calc((100vw - {{ settings.page_width }}px) / 2 + {{ settings.page_padding }}px));
        --tact-space: {{ settings.section_spacing }}px;
        --tact-grid-gap: {{ settings.grid_gap }}px;
        --tact-font-body: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
        --tact-font-heading: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
        --tact-font-accent: {{ settings.accent_font.family }}, {{ settings.accent_font.fallback_families }};
        --tact-body-size: {{ settings.body_font_size }}px;
        --tact-body-line: {{ settings.body_line_height }};
        --tact-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --tact-heading-tracking: {{ settings.heading_letter_spacing | divided_by: 100.0 }}em;
        --tact-label-tracking: {{ settings.label_letter_spacing | divided_by: 100.0 }}em;
        --tact-icon-size: {{ settings.icon_size }}px;
        --tact-icon-stroke: {{ settings.icon_stroke }};
        --tact-logo-width: {{ settings.logo_width }}px;
        --tact-logo-width-mobile: {{ settings.logo_width_mobile }}px;
      }
      html[data-theme="dark"] {
        --tact-ink: {{ settings.dark_color_ink }};
        --tact-paper: {{ settings.dark_color_paper }};
        --tact-surface: {{ settings.dark_color_surface }};
        --tact-muted: {{ settings.dark_color_muted }};
        --tact-accent: {{ settings.dark_color_accent }};
        --tact-button: {{ settings.dark_color_button }};
        --tact-button-text: {{ settings.dark_color_button_text }};
        --tact-shadow: rgb(0 0 0 / 42%);
      }
      @media (max-width: 749px) {
        :root { --tact-page: {{ settings.page_padding_mobile }}px; }
      }
      {{ settings.custom_css }}
    </style>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body
    class="template-{{ template.name }}"
    data-customer-authenticated="{% if customer %}true{% else %}false{% endif %}"
    data-customer-id="{% if customer %}{{ customer.id | append: ':' | append: shop.permanent_domain | sha256 }}{% else %}guest{% endif %}"
    data-account-login-url="{{ routes.account_login_url }}"
  >
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </body>
</html>
