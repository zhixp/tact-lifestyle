<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}
      {%- if current_tags %} — {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} — Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'refinement.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --tact-ink: {{ settings.color_ink }};
        --tact-paper: {{ settings.color_paper }};
        --tact-accent: {{ settings.color_accent }};
        --tact-radius: {{ settings.card_radius }}px;
      }
    </style>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </body>
</html>
