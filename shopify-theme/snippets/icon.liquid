{% liquid
  assign icon_override = custom_icon
  if icon_override == blank
    case icon
      when 'menu'
        assign icon_override = settings.icon_menu
      when 'close'
        assign icon_override = settings.icon_close
      when 'search'
        assign icon_override = settings.icon_search
      when 'bag'
        assign icon_override = settings.icon_bag
      when 'user'
        assign icon_override = settings.icon_account
      when 'home'
        assign icon_override = settings.icon_home
      when 'arrow'
        assign icon_override = settings.icon_arrow
      when 'heart'
        assign icon_override = settings.icon_wishlist
      when 'plus'
        assign icon_override = settings.icon_plus
    endcase
  endif
%}

{% if icon_override != blank %}
  {{
    icon_override
    | image_url: width: 96
    | image_tag:
      class: 't-custom-icon',
      loading: 'lazy',
      widths: '32, 48, 64, 96',
      alt: ''
  }}
{% else %}
  {% case icon %}
    {% when 'menu' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
    {% when 'close' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
    {% when 'search' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
    {% when 'bag' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
    {% when 'user' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20c.7-4.2 3.2-6.3 7.5-6.3s6.8 2.1 7.5 6.3"/></svg>
    {% when 'home' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 11 8-7 8 7v9h-6v-6h-4v6H4v-9Z"/></svg>
    {% when 'arrow' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
    {% when 'ruler' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 16 12-12 4 4L8 20H4v-4Z"/><path d="m12 8 2 2m1-5 4 4M9 11l2 2m-5 1 2 2"/></svg>
    {% when 'fabric' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7c4-4 12-4 16 0v10c-4 4-12 4-16 0V7Z"/><path d="M4 10c4 4 12 4 16 0M4 14c4-4 12-4 16 0"/></svg>
    {% when 'card' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M7 15h4"/></svg>
    {% when 'truck' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v11H3V6Zm11 4h4l3 3v4h-7v-7Z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
    {% when 'return' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8 12 4l7 4v8l-7 4-7-4V8Z"/><path d="m5 8 7 4 7-4m-7 4v8M8 5.8l7 4"/><path d="M3 12H1m2 0-2-2m2 2-2 2"/></svg>
    {% when 'tag' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5v6l9 9 7-7-9-9H5a1 1 0 0 0-1 1Z"/><circle cx="8" cy="8" r="1.3"/></svg>
    {% when 'star' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.75 5.57 6.15.9-4.45 4.33 1.05 6.12L12 17.03l-5.5 2.89 1.05-6.12L3.1 9.47l6.15-.9L12 3Z"/></svg>
    {% when 'heart' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 5.8c-2-2.1-5.4-2.1-7.4 0L12 7.2l-1.4-1.4c-2-2.1-5.4-2.1-7.4 0s-2 5.4 0 7.4L12 22l8.8-8.8c2-2 2-5.4 0-7.4Z"/></svg>
    {% when 'plus' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    {% when 'check' %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"/></svg>
  {% endcase %}
{% endif %}
